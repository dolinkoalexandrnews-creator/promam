# ---------------------------------------------------------------
# Скопіюй цей файл у .env.local і встав свої значення.
# .env.local у git не потрапляє — там лежать справжні ключі.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role (СЕКРЕТ, лише на сервері)
SUPABASE_SERVICE_ROLE_KEY=

# Адреса сайту (локально лишай як є, на Vercel — свій домен)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram-вхід (необов'язково на старті) ---
# Створюється у @BotFather: /newbot, потім /setdomain на домен сайту
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Push-сповіщення у браузері (необов'язково) ---
# Згенерувати: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Секрет для службових запитів cron (вигадай довгий рядок)
CRON_SECRET=
